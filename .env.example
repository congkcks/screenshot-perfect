# ==============================================================================
# NinhBinhTravel Mini App — Environment Configuration Template
# Sao chép file này thành `.env` để cấu hình môi trường phát triển cục bộ.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE MAPS JAVASCRIPT API (Client-side)
# ------------------------------------------------------------------------------
# Khóa API Google Maps để hiển thị bản đồ địa lý thực tế với phong cách màu tùy biến
# (Deep Forest Green #244B3B & Champagne Gold #D6AD72).
# Cần kích hoạt: "Maps JavaScript API" trong Google Cloud Console.
# Nếu để trống, ứng dụng sẽ tự động chuyển sang chế độ bản đồ dự phòng OpenStreetMap
# hoàn toàn miễn phí và không bị gián đoạn.
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 2. NITRO DEPLOYMENT PRESET (Build-time, Optional)
# ------------------------------------------------------------------------------
# Thiết lập preset phù hợp với hạ tầng triển khai:
# - Vercel: vercel
# - Cloudflare Pages / Workers: cloudflare-module
# - Node.js Server: node-server
# Mặc định trên Vercel, Nitro sẽ tự động nhận diện `process.env.VERCEL`.
NITRO_PRESET=vercel
