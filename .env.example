# ==============================================================================
# NinhBinhTravel Mini App — Environment Configuration Template
# Sao chép file này thành `.env` để cấu hình môi trường phát triển cục bộ.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHATBOT RAG "HƯỚNG DẪN VIÊN NINH BÌNH" (Server-side ONLY)
# ------------------------------------------------------------------------------
# Lưu ý quan trọng: Biến server-side TUYỆT ĐỐI KHÔNG có tiền tố VITE_
# Không commit file .env chứa khóa thật lên git.

# Khóa API từ nhà cung cấp dịch vụ (ShopAIKey hoặc tương thích OpenAI)
SHOPAIKEY_API_KEY=

# Địa chỉ API cơ sở (mặc định của ShopAIKey là https://api.shopaikey.com)
SHOPAIKEY_BASE_URL=https://api.shopaikey.com

# Tên mô hình trò chuyện (Ví dụ: gpt-4o-mini, claude-3-5-haiku-20241022, ...)
CHAT_MODEL=gpt-4o-mini

# Tên mô hình sinh vector nhúng (Ví dụ: text-embedding-3-small, ...)
# Nếu để trống, hệ thống sẽ tự động dùng chế độ RAG tìm kiếm theo từ khóa dự phòng.
EMBED_MODEL=text-embedding-3-small

# Ngưỡng điểm tương đồng tối thiểu cho RAG (mặc định 0.25 cho vector, từ khóa tự điều chỉnh)
RAG_MIN_SCORE=0.25

# Trần số lượt yêu cầu chat tối đa mỗi ngày nhằm bảo vệ số dư tài khoản
DAILY_REQUEST_CAP=300

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS JAVASCRIPT API (Client-side)
# ------------------------------------------------------------------------------
# Khóa API Google Maps để hiển thị bản đồ địa lý thực tế với phong cách màu tùy biến
# (Deep Forest Green #244B3B & Champagne Gold #D6AD72).
# Cần kích hoạt: "Maps JavaScript API" trong Google Cloud Console.
# Nếu để trống, ứng dụng sẽ tự động chuyển sang chế độ bản đồ dự phòng OpenStreetMap
# hoàn toàn miễn phí và không bị gián đoạn.
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. NITRO DEPLOYMENT PRESET (Build-time, Optional)
# ------------------------------------------------------------------------------
# Thiết lập preset phù hợp với hạ tầng triển khai:
# - Vercel: vercel
# - Cloudflare Pages / Workers: cloudflare-module
# - Node.js Server: node-server
# Mặc định trên Vercel, Nitro sẽ tự động nhận diện `process.env.VERCEL`.
NITRO_PRESET=vercel
